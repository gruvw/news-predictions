# ----------------------------------------------------------------------------
# Text helpers
# ----------------------------------------------------------------------------
def normalize(text):
    text = text.replace("’", "'").replace("ß", "ss")
    text = re.sub(r"-\s+(?=[a-zäöüéèà])", "", text)    # OCR line-break hyphens
    return re.sub(r"\s+", " ", text).strip()


def sentences(text):
    return re.split(r"(?<=[.!?])\s+", normalize(text))


def full_text(impresso, item):
    text = (item.get("text") or {}).get("content")
    if text:
        return text
    try:
        raw = impresso.content_items.get(item["id"]).raw
        return (raw.get("text") or {}).get("content") or ""
    except Exception as e:
        print(f"  ! could not fetch {item.get('id')}: {e}")
        return ""


def contains_any(text, words):
    low = text.lower()
    return any(w.lower() in low for w in words)


def anchor_level(sent, context, topic, lang):
    """2 = anchor in sentence, 1 = in context, 0 = none."""
    anchors = TOPICS[topic]["anchors"][lang]
    if contains_any(sent, anchors):
        return 2
    if contains_any(context, anchors):
        return 1
    return 0


def verifiability_score(sent, lang, a_level):
    score = 0
    if ANCHOR_MODE != "off":
        score += a_level
    if NUMBER_RE.search(sent):
        score += 1
    if contains_any(sent, DATE_WORDS[lang]):
        score += 1
    # proper noun not at sentence start (useless in German: all nouns capitalised)
    if lang in ("fr", "en") and re.search(r"(?<=[a-zéèàç,;] )[A-ZÉÈ][a-zéèêàç]{2,}", sent):
        score += 1
    if contains_any(sent, VAGUE[lang]):
        score -= 2
    return score

# ----------------------------------------------------------------------------
# Collection
# ----------------------------------------------------------------------------
def collect_topic(impresso, topic, quota, seen, rejected, stats):
    conf = TOPICS[topic]
    found = []
    cues = [(lang, c) for lang, lst in conf["cues"].items() for c in lst]

    for lang, cue in cues:
        st = {"topic": topic, "language": lang, "cue": cue, "articles_scanned": 0,
              "sentences_matched": 0, "kept": 0, "rej_length": 0,
              "rej_duplicate": 0, "rej_retrospective": 0, "rej_no_anchor": 0,
              "rej_low_score": 0}
        stats.append(st)
        pattern = re.compile(re.escape(normalize(cue)), re.IGNORECASE)

        try:
            result = impresso.search.find(term=f'"{cue}"', language=lang,
                                          with_text_contents=True,
                                          date_range=DATE_RANGE)
        except Exception as e:
            print(f"  ! search failed for {cue!r}: {e}")
            continue

        done = False
        try:
            for page in result.pages():
                for item in page.raw["data"]:
                    st["articles_scanned"] += 1
                    meta = item.get("meta") or {}
                    date = str(meta.get("date", ""))[:10]
                    sents = sentences(full_text(impresso, item))

                    for k, sent in enumerate(sents):
                        if not pattern.search(sent):
                            continue
                        st["sentences_matched"] += 1
                        context = " ".join(sents[max(k - 2, 0):k + 3])
                        a_lvl = anchor_level(sent, context, topic, lang)
                        score = verifiability_score(sent, lang, a_lvl)

                        reason = None
                        if not (40 <= len(sent) <= 600):
                            reason = "length"
                        elif sent.lower() in seen:
                            reason = "duplicate"
                        elif contains_any(sent, RETROSPECTIVE[lang]):
                            reason = "retrospective"
                        elif ANCHOR_MODE == "required" and a_lvl == 0:
                            reason = "no_anchor"
                        elif score < MIN_SCORE:
                            reason = "low_score"

                        if reason:
                            st[f"rej_{reason}"] += 1
                            if reason != "duplicate":
                                rejected.append({
                                    "impresso_id": item["id"], "publication_date": date,
                                    "language": lang, "topic": topic, "cue": cue,
                                    "reason": reason, "anchor_level": a_lvl,
                                    "verifiability_score": score,
                                    "statement_original": sent})
                            continue

                        seen.add(sent.lower())
                        found.append({
                            "impresso_id": item["id"],
                            "publication_date": date,
                            "newspaper": meta.get("mediaTitle") or meta.get("mediaId", ""),
                            "language": lang, "topic": topic, "cue": cue,
                            "outcome_type": conf["outcome_type"],
                            "anchor_level": a_lvl,
                            "verifiability_score": score,
                            "source_hint": conf["source_hint"],
                            "statement_original": sent,
                            "context_original": context,
                        })
                        st["kept"] += 1
                        break            # one statement per article

                    if st["articles_scanned"] >= MAX_ARTICLES_PER_CUE:
                        done = True
                        break
                if done:
                    break
                time.sleep(SLEEP)
        except Exception as e:
            print(f"  ! paging failed for {cue!r}: {e}")

        print(f"  [{topic}/{lang}] {cue!r}: kept {st['kept']} / "
              f"{st['sentences_matched']} matches ({st['articles_scanned']} articles)")

    found.sort(key=lambda r: r["verifiability_score"], reverse=True)
    return found[:quota]


def write_csv(path, columns, rows):
    with open(path, "w", newline="", encoding="utf-8-sig") as f:   # -sig: Excel-friendly
        writer = csv.DictWriter(f, fieldnames=columns, restval="", extrasaction="ignore")
        writer.writeheader()
        writer.writerows(rows)


def main():
    print(f"TEST_MODE={TEST_MODE}  ANCHOR_MODE={ANCHOR_MODE}  MIN_SCORE={MIN_SCORE}")
    impresso = connect()
    seen, rows, rejected, stats = set(), [], [], []

    for topic, conf in TOPICS.items():
        quota = round(TARGET * conf["share"])
        print(f"\n== {topic} (quota {quota}) ==")
        rows.extend(collect_topic(impresso, topic, quota, seen, rejected, stats))

    rows.sort(key=lambda r: (r["topic"], r["publication_date"]))
    for i, r in enumerate(rows, 1):
        r["candidate_id"] = f"C{i:05d}"

    write_csv(OUTPUT, COLUMNS, rows)
    write_csv(REJECTED_OUTPUT, REJECTED_COLUMNS, rejected)
    write_csv(STATS_OUTPUT, STATS_COLUMNS, stats)

    print(f"\nWrote {len(rows)} candidates to {OUTPUT}")
    for topic in TOPICS:
        for lang in ("fr", "de", "en"):
            n = sum(r["topic"] == topic and r["language"] == lang for r in rows)
            print(f"  {topic}/{lang}: {n}")
    print(f"Rejected sentences logged: {len(rejected)} -> {REJECTED_OUTPUT}")
    print(f"Per-cue statistics -> {STATS_OUTPUT}")


if __name__ == "__main__":
    main()