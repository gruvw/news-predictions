"""Step 1 (v2) - Topic-targeted prediction candidates from Impresso.

Strategy
--------
For each topic (Swiss votes, sport, elections) and language, search Impresso for
domain-specific predictive phrases. Keep a sentence only if:
  1. it contains the cue,
  2. a topic anchor appears in the sentence or its immediate context,
  3. it contains no retrospective marker ("comme prévu", "wie erwartet"...),
  4. its verifiability score reaches MIN_SCORE.
Candidates are balanced across topics and ranked by verifiability score.

Usage:
    pip install impresso
    python extract_candidates_v2.py
"""

import csv
import re
import time

from impresso import DateRange, connect

# ----------------------------------------------------------------------------
# Parameters
# ----------------------------------------------------------------------------
TARGET = 200                    # total candidates to export
MAX_ARTICLES_PER_CUE = 40       # safety cap per cue
MIN_SCORE = 3                   # minimum verifiability score
DATE_RANGE = None               # e.g. DateRange("1900-01-01", "1999-12-31")
SLEEP = 0.5                     # pause between API calls (rate limiting)
OUTPUT = "prediction_candidates_v2.csv"

# ----------------------------------------------------------------------------
# Topic definitions: predictive cues (used as search queries) + anchors
# ----------------------------------------------------------------------------
TOPICS = {
    "swiss_vote": {
        "outcome_type": "binary_vote",
        "source_hint": "https://swissvotes.ch",
        "share": 0.45,          # proportion of TARGET for this topic
        "cues": {
            "fr": ["sera acceptée", "sera rejetée", "sera repoussée", "sera adoptée",
                   "le peuple acceptera", "le peuple rejettera", "le oui l'emportera",
                   "le non l'emportera", "l'initiative passera",
                   "a de bonnes chances d'être acceptée", "sera probablement rejetée",
                   "sera probablement acceptée", "sera sans doute rejetée",
                   "sera sans doute acceptée"],
            "de": ["wird angenommen werden", "wird abgelehnt werden",
                   "wird verworfen werden", "dürfte angenommen werden",
                   "dürfte abgelehnt werden", "dürfte verworfen werden",
                   "wird durchfallen", "wird wahrscheinlich angenommen",
                   "wird wahrscheinlich abgelehnt"],
        },
        "anchors": {
            "fr": ["votation", "initiative", "référendum", "referendum", "scrutin",
                   "peuple et les cantons", "souverain", "urnes", "électeurs"],
            "de": ["abstimmung", "volksinitiative", "initiative", "referendum",
                   "urnengang", "volk und stände", "stimmbürger", "souverän", "urne"],
        },
    },
    "sport": {
        "outcome_type": "winner_or_score",
        "source_hint": "Wikipedia / archives des fédérations",
        "share": 0.30,
        "cues": {
            "fr": ["partira favori", "est le grand favori", "devrait l'emporter",
                   "devrait remporter", "s'imposera", "remportera", "gagnera le",
                   "les pronostics donnent", "a toutes les chances de gagner"],
            "de": ["gilt als Favorit", "ist der grosse Favorit", "dürfte gewinnen",
                   "wird gewinnen", "wird siegen", "dürfte siegen",
                   "ist der Sieg kaum zu nehmen"],
        },
        "anchors": {
            "fr": ["match", "finale", "championnat", "coupe", "tour de france",
                   "jeux olympiques", "étape", "course", "équipe", "coureur"],
            "de": ["spiel", "final", "meisterschaft", "cup", "rennen", "olympische",
                   "etappe", "mannschaft", "fahrer", "match"],
        },
    },
    "election": {
        "outcome_type": "elected_or_seats",
        "source_hint": "admin.ch / OFS / Wikipedia",
        "share": 0.25,
        "cues": {
            "fr": ["sera élu", "sera réélu", "devrait être élu", "sera battu",
                   "obtiendra la majorité", "gagnera des sièges", "perdra des sièges"],
            "de": ["wird gewählt werden", "dürfte gewählt werden", "wird wiedergewählt",
                   "dürfte wiedergewählt werden", "wird Sitze gewinnen",
                   "wird Sitze verlieren"],
        },
        "anchors": {
            "fr": ["élection", "conseil fédéral", "conseil national", "conseil des états",
                   "candidat", "scrutin", "siège", "parti"],
            "de": ["wahl", "bundesrat", "nationalrat", "ständerat", "kandidat",
                   "wahlen", "sitz", "partei"],
        },
    },
}

# Retrospective markers -> report, not prediction
RETROSPECTIVE = {
    "fr": ["comme prévu", "comme on l'avait prévu", "comme on s'y attendait",
           "ainsi qu'on l'avait prévu", "a été acceptée", "a été rejetée", "a été élu"],
    "de": ["wie erwartet", "wie vorausgesagt", "wie vorauszusehen war",
           "wurde angenommen", "wurde abgelehnt", "wurde gewählt"],
}

# Signals that make an outcome checkable
NUMBER_RE = re.compile(r"\d+\s*(%|pour\s*cent|prozent)|\d+\s*[-:à]\s*\d+|\d{2,}", re.I)
DATE_WORDS = {
    "fr": ["dimanche", "demain", "prochain", "prochaine", "samedi", "janvier",
           "février", "mars", "avril", "mai", "juin", "juillet", "août",
           "septembre", "octobre", "novembre", "décembre"],
    "de": ["sonntag", "morgen", "nächsten", "kommenden", "samstag", "januar",
           "februar", "märz", "april", "mai", "juni", "juli", "august",
           "september", "oktober", "november", "dezember"],
}
VAGUE = {
    "fr": ["peut-être", "il se pourrait", "qui sait", "on ne sait"],
    "de": ["vielleicht", "möglicherweise", "wer weiss", "man weiss nicht"],
}

COLUMNS = [
    "candidate_id", "impresso_id", "publication_date", "newspaper", "language",  # step 1
    "topic", "cue", "outcome_type", "verifiability_score", "source_hint",        # step 1
    "statement_original", "context_original",                                    # step 1
    "author", "category", "statement_en",                                        # step 2
    "resolution_date", "horizon_days", "predicted_value",                        # step 2
    "actual_value", "outcome_confidence", "outcome_source_url",                  # step 3
    "accuracy",                                                                  # step 3
]

# ----------------------------------------------------------------------------
# Text helpers
# ----------------------------------------------------------------------------
def normalize(text):
    text = text.replace("’", "'").replace("ß", "ss")   # Swiss German spelling
    text = re.sub(r"-\s+(?=[a-zäöüéèà])", "", text)    # OCR line-break hyphens
    return re.sub(r"\s+", " ", text).strip()


def sentences(text):
    return re.split(r"(?<=[.!?])\s+", normalize(text))


def full_text(impresso, item):
    text = (item.get("text") or {}).get("content")
    if text:
        return text
    try:
        raw = impresso.content_items.get(item["id"]).raw
        return (raw.get("text") or {}).get("content") or ""
    except Exception as e:                       # network / missing item
        print(f"  ! could not fetch {item.get('id')}: {e}")
        return ""


def contains_any(text, words):
    low = text.lower()
    return any(w.lower() in low for w in words)


def verifiability_score(sent, context, topic, lang):
    """Heuristic score: higher = more likely a checkable prediction."""
    anchors = TOPICS[topic]["anchors"][lang]
    score = 0
    if contains_any(sent, anchors):
        score += 2
    elif contains_any(context, anchors):
        score += 1
    if NUMBER_RE.search(sent):
        score += 1
    if contains_any(sent, DATE_WORDS[lang]):
        score += 1
    # proper noun after the first word (only meaningful in French: German
    # capitalises all nouns)
    if lang == "fr" and re.search(r"(?<!^)(?<![.!?] )\b[A-ZÉÈ][a-zéèêàç]{2,}", sent):
        score += 1
    if contains_any(sent, VAGUE[lang]):
        score -= 2
    return score

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
def collect_topic(impresso, topic, quota, seen):
    conf = TOPICS[topic]
    found = []
    cues = [(lang, c) for lang, lst in conf["cues"].items() for c in lst]

    for lang, cue in cues:
        pattern = re.compile(re.escape(normalize(cue)), re.IGNORECASE)
        try:
            result = impresso.search.find(term=f'"{cue}"', language=lang,
                                          with_text_contents=True,
                                          date_range=DATE_RANGE)
        except Exception as e:
            print(f"  ! search failed for {cue!r}: {e}")
            continue

        scanned, kept = 0, 0
        for page in result.pages():
            for item in page.raw["data"]:
                scanned += 1
                sents = sentences(full_text(impresso, item))
                for k, sent in enumerate(sents):
                    if not pattern.search(sent):
                        continue
                    if not (40 <= len(sent) <= 600) or sent.lower() in seen:
                        continue
                    context = " ".join(sents[max(k - 2, 0):k + 3])
                    if contains_any(sent, RETROSPECTIVE[lang]):
                        continue
                    score = verifiability_score(sent, context, topic, lang)
                    if score < MIN_SCORE:
                        continue
                    seen.add(sent.lower())
                    meta = item.get("meta") or {}
                    found.append({
                        "impresso_id": item["id"],
                        "publication_date": str(meta.get("date", ""))[:10],
                        "newspaper": meta.get("mediaTitle") or meta.get("mediaId", ""),
                        "language": lang,
                        "topic": topic,
                        "cue": cue,
                        "outcome_type": conf["outcome_type"],
                        "verifiability_score": score,
                        "source_hint": conf["source_hint"],
                        "statement_original": sent,
                        "context_original": context,
                    })
                    kept += 1
                    break                # one statement per article: more diversity
                if scanned >= MAX_ARTICLES_PER_CUE:
                    break
            if scanned >= MAX_ARTICLES_PER_CUE:
                break
            time.sleep(SLEEP)
        print(f"  [{topic}/{lang}] {cue!r}: +{kept} ({scanned} articles scanned)")

    # keep the best-scored candidates for this topic
    found.sort(key=lambda r: r["verifiability_score"], reverse=True)
    return found[:quota]


def main():
    impresso = connect()
    seen, rows = set(), []

    for topic, conf in TOPICS.items():
        quota = round(TARGET * conf["share"])
        print(f"== {topic} (quota {quota}) ==")
        rows.extend(collect_topic(impresso, topic, quota, seen))

    rows.sort(key=lambda r: (r["topic"], r["publication_date"]))
    for i, r in enumerate(rows, 1):
        r["candidate_id"] = f"C{i:05d}"

    with open(OUTPUT, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=COLUMNS, restval="")
        writer.writeheader()
        writer.writerows(rows)

    print(f"\nWrote {len(rows)} candidates to {OUTPUT}")
    for topic in TOPICS:
        n = sum(r["topic"] == topic for r in rows)
        print(f"  {topic}: {n}")


if __name__ == "__main__":
    main()
